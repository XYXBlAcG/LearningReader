{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XYXBlAcG/LearningReader/blob/main/Schemas/course.schema.json",
  "title": "知序课程清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "entry",
    "sections",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/].*\\.md$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redirects": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "title"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "note",
            "exercise"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "program",
        "arguments"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._+-]*$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
