{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "课程术语元数据",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "term", "aliases", "subject", "related", "notes"],
  "properties": {
    "id": {"type":"string", "pattern":"^[a-z][a-z0-9.-]{2,95}$"},
    "term": {"type":"string", "minLength":1, "maxLength":80},
    "aliases": {"type":"array", "maxItems":30, "uniqueItems":true, "items":{"type":"string", "minLength":1, "maxLength":80}},
    "subject": {"type":"string", "minLength":1, "maxLength":40},
    "related": {"type":"array", "maxItems":30, "uniqueItems":true, "items":{"type":"string"}},
    "notes": {"type":"array", "maxItems":20, "items":{"type":"object", "additionalProperties":false, "required":["kind","path","anchor"], "properties":{"kind":{"enum":["note","exercise"]},"path":{"type":"string","minLength":1},"anchor":{"type":"string"}}}}
  }
}
