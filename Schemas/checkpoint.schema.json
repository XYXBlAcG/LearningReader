{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "随堂自测题", "type": "object", "additionalProperties": false,
  "required": ["id", "revision", "type", "stem", "options", "correct", "explanation", "concept", "group", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"},
    "revision": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "enum": ["single", "multiple"]},
    "stem": {"type": "string", "minLength": 1, "maxLength": 12000},
    "options": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/option"}},
    "correct": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "explanation": {"type": "string", "minLength": 1, "maxLength": 16000},
    "concept": {"type": "string", "minLength": 1, "maxLength": 120},
    "group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"},
    "review": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "$defs": {
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "feedback"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "feedback": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    }
  }
}
